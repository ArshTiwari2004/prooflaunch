# Copy to .env and edit.  NEVER commit .env
DB_NAME=prooflaunch
DB_USER=prooflaunch
DB_PASSWORD=change-me-to-a-long-random-password

# >= 32 chars. Generate:  openssl rand -base64 48
JWT_SECRET=

# Public URL of the site (used for SEO, sitemap, canonical URLs)
SITE_URL=http://localhost:3000

# Set to "true" when serving over HTTPS (marks the session cookie Secure)
COOKIE_SECURE=false

# "demo" loads fictional sample products + users (maker@demo.prooflaunch.dev / DemoPass#2026). Leave empty in production.
SPRING_PROFILES_ACTIVE=demo
